# Local development uses SQLite — no setup required.
DATABASE_URL="file:./dev.db"

# When deploying to web.com.ph (MySQL), switch the provider in prisma/schema.prisma to "mysql"
# and set DATABASE_URL like:
# DATABASE_URL="mysql://user:password@host:3306/carsucomits"

# Auth secret (generate any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"
