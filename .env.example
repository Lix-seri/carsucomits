# ─────────────────────────────────────────────────────────────────────────────
# CarsuComits — environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in real values.
# DO NOT commit your real .env to git.

# Postgres connection string from Neon (https://neon.tech).
# Format: postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Use the "pooled" connection string for production (Vercel serverless).
DATABASE_URL="postgres://USER:PASSWORD@HOST.neon.tech/carsucomits?sslmode=require"

# Vercel Blob storage token (https://vercel.com/dashboard).
# Auto-injected on Vercel deployments — only needed locally if you want to test
# avatar uploads from your laptop.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Long random string used by the cookie session (any 32+ char value works).
AUTH_SECRET="change-me-to-a-long-random-string"
