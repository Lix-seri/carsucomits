// CarsuComits — production schema (Postgres on Neon, hosted by Vercel).
// All status/category fields use real enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT_EMPLOYEE
  COMMISSIONER
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum Category {
  ACADEMIC
  TECHNICAL
  GENERAL_ERRANDS
  ADMINISTRATIVE
}

enum CommissionStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETED
  CANCELLED
  DISPUTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ReportStatus {
  PENDING
  UNDER_INVESTIGATION
  RESOLVED
  ESCALATED
}

enum AccountStatus {
  ACTIVE
  WARNED
  SUSPENDED
  BANNED
}

enum DeliverableStatus {
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

model User {
  id                     String        @id @default(cuid())
  fullName               String
  email                  String        @unique
  passwordHash           String
  role                   Role          @default(STUDENT_EMPLOYEE)
  status                 AccountStatus @default(ACTIVE)
  bio                    String?
  avatarUrl              String?
  emailVerified          Boolean       @default(false)
  emailVerificationToken String?       @unique
  emailVerifiedAt        DateTime?
  // MFA — currently only required for ADMIN accounts but the columns are on every user.
  mfaEnabled             Boolean       @default(false)
  totpSecret             String?
  mfaBackupCodes         String?       // JSON-encoded array of one-time recovery codes
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  skills              Skill[]
  postedCommissions   Commission[]      @relation("commissioner")
  applications        Application[]
  receivedRatings     Rating[]          @relation("ratee")
  givenRatings        Rating[]          @relation("rater")
  filedReports        Report[]          @relation("reporter")
  receivedReports     Report[]          @relation("reportee")
  sentMessages        Message[]         @relation("sender")
  receivedMessages    Message[]         @relation("recipient")
  notifications       Notification[]
  auditLogs           AuditLog[]
  savedCommissions    SavedCommission[]
  submittedDeliverables Deliverable[]   @relation("submitter")
  passwordResetTokens PasswordResetToken[]
}

model Skill {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  level     SkillLevel
  createdAt DateTime   @default(now())

  @@index([userId])
}

model Commission {
  id             String           @id @default(cuid())
  title          String
  description    String
  category       Category
  subcategory    String?
  requiredLevel  SkillLevel
  fareMin        Int
  fareMax        Int?
  fareUnit       String?
  coverImageUrl  String?
  deadline       DateTime?
  status         CommissionStatus @default(OPEN)
  commissioner   User             @relation("commissioner", fields: [commissionerId], references: [id])
  commissionerId String
  awardedToId    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  applications Application[]
  ratings      Rating[]
  messages     Message[]
  reports      Report[]
  savedBy      SavedCommission[]
  deliverables Deliverable[]

  @@index([category])
  @@index([status])
  @@index([commissionerId])
}

model Application {
  id           String            @id @default(cuid())
  commission   Commission        @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId String
  applicant    User              @relation(fields: [applicantId], references: [id])
  applicantId  String
  coverLetter  String?
  proposedRate Int?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@unique([commissionId, applicantId])
  @@index([applicantId])
}

model Rating {
  id           String     @id @default(cuid())
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId String
  rater        User       @relation("rater", fields: [raterId], references: [id])
  raterId      String
  ratee        User       @relation("ratee", fields: [rateeId], references: [id])
  rateeId      String
  stars        Int
  comment      String?
  createdAt    DateTime   @default(now())

  @@unique([commissionId, raterId, rateeId])
  @@index([rateeId])
}

model Message {
  id           String      @id @default(cuid())
  commission   Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)
  commissionId String?
  sender       User        @relation("sender", fields: [senderId], references: [id])
  senderId     String
  recipient    User        @relation("recipient", fields: [recipientId], references: [id])
  recipientId  String
  body         String
  readAt       DateTime?
  createdAt    DateTime    @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
}

model Report {
  id            String       @id @default(cuid())
  reporter      User         @relation("reporter", fields: [reporterId], references: [id])
  reporterId    String
  reportee      User         @relation("reportee", fields: [reporteeId], references: [id])
  reporteeId    String
  commission    Commission?  @relation(fields: [commissionId], references: [id])
  commissionId  String?
  reason        String
  details       String?
  status        ReportStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([status])
  @@index([reporteeId])
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String
  target    String?
  meta      String?
  // Field values before and after the change; append-only (a trigger rejects UPDATE/DELETE).
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([target])
}

// ─────────────────────────────────────────────────────────────────────────────
// New models for the feature batch
// ─────────────────────────────────────────────────────────────────────────────

model SavedCommission {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId String
  createdAt    DateTime   @default(now())

  @@unique([userId, commissionId])
  @@index([userId])
}

model Deliverable {
  id            String            @id @default(cuid())
  commission    Commission        @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  commissionId  String
  submitter     User              @relation("submitter", fields: [submitterId], references: [id])
  submitterId   String
  fileUrl       String
  fileName      String
  fileSize      Int
  message       String?
  status        DeliverableStatus @default(SUBMITTED)
  reviewerNotes String?
  submittedAt   DateTime          @default(now())
  reviewedAt    DateTime?

  @@index([commissionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Admin-configurable limits (claude/decisions/0010). A missing row means the default in code.
model Setting {
  key         String   @id
  value       Int
  updatedById String?
  updatedAt   DateTime @updatedAt
}
